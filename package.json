{
  "name": "chessgym",
  "private": true,
  "scripts": {
    "worker:login": "wrangler login",
    "worker:kv:create": "wrangler kv namespace create SUGGESTIONS",
    "worker:dev": "wrangler dev --config wrangler.suggestion.jsonc",
    "worker:deploy": "wrangler deploy --config wrangler.suggestion.jsonc",
    "worker:secret:admin": "wrangler secret put ADMIN_TOKEN --config wrangler.suggestion.jsonc",
    "worker:secret:submit": "wrangler secret put SUBMIT_TOKEN --config wrangler.suggestion.jsonc"
  },
  "devDependencies": {
    "wrangler": "^4.87.0"
  }
}
